# Salin file ini menjadi .env lalu isi nilainya.

# Kata sandi tim untuk masuk aplikasi (WAJIB diisi bila disebar ke tim)
APP_PASSWORD=
# Kata sandi admin untuk mengganti cookie (kosong = sama dengan APP_PASSWORD)
ADMIN_PASSWORD=
# Kunci acak untuk menandatangani sesi login — isi string panjang acak
SECRET_KEY=

# Lokasi file cookie FastMoss (bawaan: config/cookies.txt)
# FM_COOKIE_FILE=config/cookies.txt

# Negara bawaan (ID, MY, TH, VN, PH, US, ...)
# FM_REGION=ID
# Jeda minimum antar-request ke FastMoss, detik
# FM_MIN_INTERVAL=1.0
# Lama cache hasil, detik
# FM_CACHE_TTL=600
# Batas baris paket gratis (ikut tampilan FastMoss)
# FM_FREE_ROW_LIMIT=5
# Batas baris ekspor sekali jalan
# FM_EXPORT_MAX_ROWS=500
